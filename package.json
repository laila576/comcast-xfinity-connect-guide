{
  "name": "comcast-xfinity-independent-portal",
  "version": "1.0.0",
  "private": true,
  "description": "Independent Comcast/Xfinity public-information portal with a support-request backend and Telegram notifications.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch src/server.ts\" \"vite --host 0.0.0.0\"",
    "build": "npm run prisma:generate && tsc -p tsconfig.server.json && vite build",
    "start": "node dist-server/server.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "zod": "^3.24.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "tsx": "^4.19.4",
    "vitest": "^3.1.3",
    "supertest": "^7.1.1",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.1.2"
  }
}
